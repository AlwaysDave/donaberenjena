rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdvancedAdmin() {
      return isAdmin() && 
        (getAdminDoc().data.role == 'advanced' || 
         getAdminDoc().data.role == 'super_admin' || 
         getAdminDoc().data.role == 'admin');
    }

    function isSimpleAdmin() {
      return isAdmin() && getAdminDoc().data.role == 'simple';
    }

    // Door check-in permissions for simple admin on proxima activities
    function isAllowedSimpleDoorTransition() {
      return isSimpleAdmin() &&
        request.resource.data.activityId == resource.data.activityId &&
        (resource.data.status == 'pendiente_pago' || resource.data.status == 'pagada') &&
        (
          request.resource.data.status == 'asistio' ||
          (request.resource.data.status == 'cancelada' && request.resource.data.cancellationKind == 'no_presentado')
        ) &&
        !('correctedAt' in request.resource.data) &&
        !('correctionReason' in request.resource.data) &&
        get(/databases/$(database)/documents/activities/$(resource.data.activityId)).data.status == 'proxima';
    }

    // Validates contact form submission with anti-spam check
    function isValidContactMessage(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
             data.message is string && data.message.size() >= 10 && data.message.size() <= 3000 &&
             (!('website' in data) || data.website == '');
    }

    // =========================================================================
    // GLOBAL SECURITY POLICY (DEFAULT DENY)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. ACTIVITIES COLLECTION
    // Public read for catalog exploration; write restricted strictly to Advanced Admins
    // =========================================================================
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdvancedAdmin();
    }

    // =========================================================================
    // 2. PARTICIPANTS COLLECTION (PII PROTECTED)
    // Read allowed for any authenticated Admin.
    // Create/Delete restricted to Advanced Admins.
    // Update allowed to Advanced Admins OR Simple Admins for allowed door transitions.
    // =========================================================================
    match /participants/{participantId} {
      allow read: if isAdmin();
      allow create, delete: if isAdvancedAdmin();
      allow update: if isAdvancedAdmin() || isAllowedSimpleDoorTransition();
    }

    // =========================================================================
    // 3. ADMINS COLLECTION (RBAC PROFILES)
    // Read allowed only for the authenticated user on their own document.
    // Write permitted for Admins on their own document; self-elevation of role is forbidden.
    // =========================================================================
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isAdmin();
      allow update: if isOwner(uid) && isAdmin() &&
                       (request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. METRICS COLLECTION
    // Public read for aggregated occupancy/view metrics; Admin-only write.
    // =========================================================================
    match /metrics/{metricId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. MEMBERS COLLECTION
    // Strictly read & write for authenticated administrators only
    // =========================================================================
    match /members/{memberId} {
      allow read: if isAdmin();
      allow write: if isAdvancedAdmin();
    }

    // =========================================================================
    // 6. ADMIN NOTIFICATIONS COLLECTION
    // Strictly read & write for authenticated administrators only
    // =========================================================================
    match /adminNotifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 7. EXPENSES COLLECTION
    // Financial data, strictly for authenticated advanced administrators only
    // =========================================================================
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow write: if isAdvancedAdmin();
    }

    // =========================================================================
    // 8. SPONSORSHIPS COLLECTION
    // Financial data, strictly for authenticated advanced administrators only
    // =========================================================================
    match /sponsorships/{sponsorshipId} {
      allow read: if isAdmin();
      allow write: if isAdvancedAdmin();
    }

    // =========================================================================
    // 8.1. GENERAL INCOMES (ASOCIACIÓN) COLLECTION
    // Financial data, strictly for authenticated advanced administrators only
    // =========================================================================
    match /generalIncomes/{incomeId} {
      allow read: if isAdmin();
      allow write: if isAdvancedAdmin();
    }

    // =========================================================================
    // 8.2. GENERAL EXPENSES (ASOCIACIÓN) COLLECTION
    // Financial data, strictly for authenticated advanced administrators only
    // =========================================================================
    match /generalExpenses/{expenseId} {
      allow read: if isAdmin();
      allow write: if isAdvancedAdmin();
    }

    // =========================================================================
    // 8.3. ANNUAL MEMBERSHIP FEES COLLECTION
    // Member fee tracking records, strictly for authenticated advanced admins
    // =========================================================================
    match /annualMembershipFees/{feeDocId} {
      allow read: if isAdmin();
      allow write: if isAdvancedAdmin();
    }


    // =========================================================================
    // 9. CONTACT MESSAGES COLLECTION
    // Public creation with field size and anti-spam checks; Admin-only read, update, delete
    // =========================================================================
    match /contactMessages/{messageId} {
      allow create: if isValidContactMessage(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 10. WEB METRICS DAILY (PRIVATE AGGREGATES - BACKEND ONLY)
    // Direct client access is denied; aggregated reading is routed via /api/metrics/acquisition.
    // =========================================================================
    match /webMetricsDaily/{dailyDocId} {
      allow read, write: if false;
    }

    // =========================================================================
    // 11. IDEMPOTENCY KEYS
    // Strictly accessible by authenticated administrators
    // =========================================================================
    match /idempotency_keys/{keyId} {
      allow read, write: if isAdmin();
    }
  }
}
