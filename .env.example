VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-side Firebase Admin credentials
# FIREBASE_SERVICE_ACCOUNT_KEY must be a JSON string on a single line containing the service account credentials.
# Do NOT commit the real service account JSON here. Configure it only in the deployment provider.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Opt-in to bypass admin auth during local development (set to true to enable)
ALLOW_DEV_AUTH_BYPASS=

GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=
GEMINI_MODEL_FALLBACK=
