{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{api/prompts/**,shared/reservationTransaction.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
