{
  "name": "react-example",
  "private": true,
  "version": "0.13.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:t04c": "tsx scripts/run-t04c-tests.ts",
    "test:fase1": "tsx scripts/run-fase1-tests.ts && tsx scripts/run-fase1-t06-tests.ts",
    "test:t11": "tsx scripts/run-t11-tests.ts",
    "test:t11:emulator": "firebase emulators:exec --only firestore,auth --project test-project \"tsx scripts/run-t11-tests.ts\"",
    "test:attendance-close:emulator": "firebase emulators:exec --only firestore,auth --project test-project \"tsx scripts/run-emulator-tests.ts\"",
    "test:checkin-status:emulator": "firebase emulators:exec --only firestore,auth --project test-project \"tsx scripts/run-checkin-tests.ts\"",
    "test:fase4b:emulator": "firebase emulators:exec --only firestore,auth --project test-project \"tsx scripts/run-fase4b-tests.ts\""
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "vite": "^6.4.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.29.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.62.5",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.1.14",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
